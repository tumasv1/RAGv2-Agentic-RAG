{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus на 10.0.0.30",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat",       "name": "Stat",        "version": "" },
    { "type": "panel", "id": "bargauge",   "name": "Bar gauge",   "version": "" },
    { "type": "panel", "id": "piechart",   "name": "Pie chart",   "version": "" },
    { "type": "panel", "id": "row",        "name": "Row",         "version": "" }
  ],
  "title": "LiteLLM / Использование моделей",
  "description": "Расходы и использование LLM-шлюза LiteLLM: по ключам, моделям, провайдерам, надёжность (fallback)",
  "uid": "litellm-usage-models",
  "tags": ["llm", "litellm", "monitoring"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 42,
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "version": 1,
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Обзор",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Всего потрачено ($)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(litellm_spend_metric_total{job=\"litellm_gateway\"})",
          "legendFormat": "всего $",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Успешных LLM-запросов (всего)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(litellm_proxy_total_requests_metric_total{job=\"litellm_gateway\", route=~\"/v?1?/chat/completions\", status_code=\"200\"})",
          "legendFormat": "запросов",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Ошибок деплойментов (24ч)",
      "description": "Ошибка ответа от конкретного провайдера/деплоймента. Именно это событие запускает cooldown и переключение на fallback-провайдера в роутере LiteLLM.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(litellm_deployment_failure_responses_total{job=\"litellm_gateway\"}[24h]))",
          "legendFormat": "ошибок",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "Расходы по ключам",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 11,
      "type": "bargauge",
      "title": "Накопительные расходы по ключам ($)",
      "description": "Сумма с момента последнего рестарта процесса LiteLLM (счётчик Prometheus, обнуляется при рестарте контейнера).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "min": 0,
          "color": { "mode": "continuous-BlPu" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (api_key_alias) (litellm_spend_metric_total{job=\"litellm_gateway\"})",
          "legendFormat": "{{api_key_alias}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Дневные расходы по ключам",
      "description": "Расход за каждый день (increase за 1d). Позволяет найти конкретный день с пиковым расходом у ключа.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "barAlignment": 0,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (api_key_alias) (increase(litellm_spend_metric_total{job=\"litellm_gateway\"}[1d]))",
          "legendFormat": "{{api_key_alias}}",
          "refId": "A",
          "interval": "1d"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "Разрезы: модели и провайдеры",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },

    {
      "id": 21,
      "type": "piechart",
      "title": "Расходы по моделям",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (litellm_spend_metric_total{job=\"litellm_gateway\"})",
          "legendFormat": "{{model}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 22,
      "type": "piechart",
      "title": "Расходы по провайдерам",
      "description": "Группировка по api_provider. У модели gpt-4.1-mini основной провайдер — openrouter; nano-gpt (fallback) появится здесь только после реального переключения.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (api_provider) (litellm_spend_metric_total{job=\"litellm_gateway\"})",
          "legendFormat": "{{api_provider}}",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 25,
      "type": "row",
      "title": "Дневные запросы по ключам",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },

    {
      "id": 26,
      "type": "timeseries",
      "title": "Дневное количество запросов по ключам",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "barAlignment": 0,
            "stacking": { "mode": "normal" }
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (api_key_alias) (increase(litellm_proxy_total_requests_metric_total{job=\"litellm_gateway\", route=~\"/v?1?/chat/completions\", status_code=\"200\"}[1d]))",
          "legendFormat": "{{api_key_alias}}",
          "refId": "A",
          "interval": "1d"
        }
      ]
    },

    {
      "id": 30,
      "type": "row",
      "title": "Надёжность и fallback",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },

    {
      "id": 31,
      "type": "timeseries",
      "title": "Ошибки деплойментов по провайдеру",
      "description": "LiteLLM не отдаёт отдельную метрику «сработал fallback». Эта панель показывает ошибки конкретных деплойментов (litellm_deployment_failure_responses_total) — именно они запускают cooldown и переключение роутера на резервный провайдер.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (api_key_alias, exception_class) (increase(litellm_deployment_failure_responses_total{job=\"litellm_gateway\"}[1h]))",
          "legendFormat": "{{api_key_alias}} / {{exception_class}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 32,
      "type": "timeseries",
      "title": "gpt-4.1-mini: успешные ответы по backend (api_base)",
      "description": "Показывает какой конкретно backend реально обслужил запрос. Если появляется второй api_base (не основной OpenRouter) — значит сработал fallback или балансировка на nano-gpt.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (api_base) (rate(litellm_deployment_success_responses_total{job=\"litellm_gateway\", requested_model=\"gpt-4.1-mini\"}[10m]))",
          "legendFormat": "{{api_base}}",
          "refId": "A"
        }
      ]
    }

  ]
}
