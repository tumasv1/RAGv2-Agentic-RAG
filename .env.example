# ── LLM-провайдеры (OpenAI-совместимый API) ──
# PRIMARY — основной провайдер (сейчас OpenRouter)
LLM_PRIMARY_API_KEY=sk-...
LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=openai/gpt-4.1-mini
# FALLBACK — запасной провайдер (nano-gpt), на него шлюз переключается при сбое primary
LLM_FALLBACK_API_KEY=sk-nano-...
LLM_FALLBACK_BASE_URL=https://nano-gpt.com/api/v1
LLM_FALLBACK_MODEL=gpt-4.1-mini

# ── LLM-шлюз (LiteLLM Proxy) ──
# Ключ доступа приложения к шлюзу (= LITELLM_MASTER_KEY ниже или отдельный virtual key)
GATEWAY_API_KEY=sk-litellm-master-changeme
# Мастер-ключ самого LiteLLM (админ + дефолтный доступ). Должен начинаться с "sk-".
LITELLM_MASTER_KEY=sk-litellm-master-changeme
# Пароль Postgres, в котором LiteLLM хранит расходы/ключи/бюджеты
LITELLM_DB_PASSWORD=changeme
# GATEWAY_BASE_URL — переопределение для docker (в config.yaml по умолчанию localhost:4000)
# GATEWAY_BASE_URL=http://litellm:4000/v1

# Obsidian — путь к хранилищу заметок
# Локально: /Users/you/vault
# В Docker: /vault (путь внутри контейнера, mount задаётся в docker-compose.yml)
OBSIDIAN_VAULT=/path/to/obsidian/vault

# QDRANT_URL — только для переопределения через env (например в docker-compose)
# По умолчанию берётся из config.yaml (qdrant.url)
# QDRANT_URL=http://qdrant:6333

# WebDAV — пароль для Remotely Save (логин: obsidian)
WEBDAV_PASSWORD=changeme

# Telegram Bot (опционально)
TELEGRAM_BOT_TOKEN=

# RAGAS-оценка (опционально)
# RAGAS_JUDGE_API_KEY=sk-...
# RAGAS_JUDGE_MODEL=openai/gpt-4o-mini

# Langfuse — трейсинг графа агента (нужно ещё langfuse.enabled: true в config.yaml)
# Ключи проекта из self-hosted Langfuse (../Langfuse), Settings → API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
